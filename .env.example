# ------------------------------------------------------------------
# Variáveis PÚBLICAS do frontend (vão para o JavaScript publicado!)
# Copie para .env.local e preencha. Nunca coloque segredos aqui.
# ------------------------------------------------------------------
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave anon / publishable (pública por design; a proteção real é o RLS)
VITE_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable
# "/" em dev; "/<nome-do-repositorio>/" no GitHub Pages
VITE_BASE_PATH=/

# ------------------------------------------------------------------
# SEGREDOS DO SERVIDOR — NÃO use prefixo VITE_ e NÃO coloque em .env.local.
# Configure com:  supabase secrets set GEMINI_API_KEY=... ALLOWED_ORIGINS=...
# Para desenvolvimento local das functions use supabase/functions/.env (ignorado pelo git).
# ------------------------------------------------------------------
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# ALLOWED_ORIGINS=https://SEU-USUARIO.github.io,http://localhost:5173
